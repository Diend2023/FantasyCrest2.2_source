                                             <textRuns>
                                                  <DOMTextRun>
                                                       <characters>@左眼 2016 说明：该功能提供局域网以及广域网联机，可与您的好友进行在线PK。</characters>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑" fillColor="#000000"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters>关于如何联机：</characters>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑" fillColor="#000000"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters>1、将您的SelfKey交给您的好友，或者让您的好友将SelfKey交给您。</characters>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑" fillColor="#000000"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters>2.、其中一方将对方的SelfKey填入即可，如果成功连接对方，会给对方发起挑战信息。</characters>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑" fillColor="#000000"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters>3、对方按照提示，选择接受或者拒绝操作。</characters>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑" fillColor="#000000"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters>关于广域网联机：</characters>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑" fillColor="#000000"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters>1、该功能因为是属于P2P联机方式，如果双方需要联机，建议不要禁用P2P的功能。</characters>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑" fillColor="#000000"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters>2、同时要开放UDP的端口。</characters>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑" fillColor="#000000"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters>3、网络环境多变的原因，双方不一定能够联机；并不是100%能够进行联机。</characters>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑" fillColor="#000000"/>
                                                       </textAttrs>
                                                  </DOMTextRun>
                                                  <DOMTextRun>
                                                       <characters/>
                                                       <textAttrs>
                                                            <DOMTextAttrs alignment="left" rotation="true" indent="0.0" leftMargin="0.0" autoKern="false" lineSpacing="0.0" rightMargin="0.0" size="13" bitmapSize="260" face="微软雅黑"/>
